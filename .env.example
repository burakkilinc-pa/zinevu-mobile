# Gedipo mobile — copy to .env and adjust for your machine.
# All EXPO_PUBLIC_* vars are baked into the client bundle at build time.

# Laravel v1 API base URL.
#   iOS simulator:     http://127.0.0.1:8001/api/v1
#   Android emulator:  http://10.0.2.2:8001/api/v1
#   Physical device:   http://<your-lan-ip>:8001/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8001/api/v1

# Reverb (websockets) — used by realtime messaging (Phase 2).
EXPO_PUBLIC_REVERB_KEY=
EXPO_PUBLIC_REVERB_HOST=127.0.0.1
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# --- Social sign-in ---
# Both from the `zinevu-com` Firebase project, where the app's push config also
# lives — deliberately not the project behind the API's GOOGLE_CLIENT_ID, since
# that one issued the dealers' Google Calendar refresh tokens and moving it
# would have cut them. The API accepts this audience via GOOGLE_EXTRA_CLIENT_IDS,
# so changing the value here means changing it there too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client id (bundle com.zinevu.mobile). Its reversed form also goes
# in app.json under the google-signin plugin's iosUrlScheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
