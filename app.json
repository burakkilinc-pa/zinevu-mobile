{
  "expo": {
    "name": "Zinevu",
    "slug": "zinevu-mobile",
    "owner": "zinevu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zinevumobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zinevu.mobile",
      "supportsTablet": true,
      "appleTeamId": "MPM7UW8NS4",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zinevu.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E7FFA4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#082D36",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/zinevu.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zinevu uses your photo library so you can attach photos to leads, planning visits and chats.",
          "cameraPermission": "Zinevu uses the camera so you can take photos for leads, planning visits and chats."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Zinevu."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.937185871682-n8p53r82lvjceenuocb2cf4pgh4a1vjs"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ce3919e-5d84-4d2c-aa78-c8d599b09249"
      }
    }
  }
}
