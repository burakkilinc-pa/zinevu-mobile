{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zinevu.com/api/v1",
        "EXPO_PUBLIC_REVERB_KEY": "local-reverb-key",
        "EXPO_PUBLIC_REVERB_HOST": "api.zinevu.com",
        "EXPO_PUBLIC_REVERB_PORT": "443",
        "EXPO_PUBLIC_REVERB_SCHEME": "https"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zinevu.com/api/v1",
        "EXPO_PUBLIC_REVERB_KEY": "local-reverb-key",
        "EXPO_PUBLIC_REVERB_HOST": "api.zinevu.com",
        "EXPO_PUBLIC_REVERB_PORT": "443",
        "EXPO_PUBLIC_REVERB_SCHEME": "https"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "gediposoftware@gmail.com",
        "ascAppId": "6801282413",
        "appleTeamId": "MPM7UW8NS4"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
